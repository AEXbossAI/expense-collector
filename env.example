ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Jerusalem

# Telegram
TELEGRAM_BOT_TOKEN=changeme
TELEGRAM_CHAT_ID=0
TELEGRAM_COMPANY=orlanda_engineering
TELEGRAM_REVIEWER_ID=0

# Почта: пароль приложения Google, НЕ пароль аккаунта.
# Требуется включённая двухэтапка на ящике.
IMAP_HOST=imap.gmail.com
IMAP_USER=invoices@orlanda.info
IMAP_PASSWORD=changeme

# Dropbox: командный аккаунт Orlanda.
# TEAM_MEMBER_ID и NAMESPACE_ID обязательны, иначе запись уйдёт
# в личное пространство участника вместо командного.
DROPBOX_APP_KEY=changeme
DROPBOX_APP_SECRET=changeme
DROPBOX_REFRESH_TOKEN=changeme
DROPBOX_TEAM_MEMBER_ID=
DROPBOX_NAMESPACE_ID=
DROPBOX_COMPANY_ROOTS={"orlanda_engineering": "/Finance/AMS Group_accouting", "orlanda_israel": "/Finance/Orlanda Israel/Invoices"}
DROPBOX_INBOX_PATH=/Karash Nazarov/expense-inbox

# Точное вхождение названия юрлица решает, чей это документ.
COMPANY_LEGAL_NAMES={"orlanda_engineering": ["Orlanda Engineering"], "orlanda_israel": ["Orlanda Israel", "Orlanda Israel marketing & sales"]}

ANTHROPIC_API_KEY=changeme

DATABASE_URL=postgresql+asyncpg://user:pass@db-router:6432/expenses
REDIS_URL=redis://redis:6379/0
