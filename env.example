ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Jerusalem

# Telegram
TELEGRAM_BOT_TOKEN=changeme
TELEGRAM_CHAT_ID=0
TELEGRAM_COMPANY=orlanda_engineering
TELEGRAM_REVIEWER_ID=0

# Почта: пароль приложения Google, НЕ пароль аккаунта.
# Требуется включённая двухэтапка на ящике.
IMAP_HOST=imap.gmail.com
IMAP_USER=invoices@orlanda.info
IMAP_PASSWORD=changeme

# Dropbox: командный аккаунт Orlanda.
# TEAM_MEMBER_ID и NAMESPACE_ID обязательны, иначе запись уйдёт
# в личное пространство участника вместо командного.
DROPBOX_APP_KEY=changeme
DROPBOX_APP_SECRET=changeme
DROPBOX_REFRESH_TOKEN=changeme
DROPBOX_TEAM_MEMBER_ID=
DROPBOX_NAMESPACE_ID=
DROPBOX_COMPANY_ROOTS={"orlanda_engineering": "/Finance/AMS Group_accouting", "orlanda_israel": "/Finance/Orlanda Israel/Invoices"}
DROPBOX_INBOX_PATH=/Karash Nazarov/expense-inbox

# Точное вхождение названия юрлица решает, чей это документ.
COMPANY_LEGAL_NAMES={"orlanda_engineering": ["16503223", "EE102602283", "Orlanda Engineering"], "orlanda_israel": ["512354424", "Orlanda Israel", "אורלנדה ישראל"]}

ANTHROPIC_API_KEY=changeme

DATABASE_URL=postgresql+asyncpg://user:pass@db-router:6432/expenses
REDIS_URL=redis://redis:6379/0

# Только то, что никогда не бывает документом расхода.
SENDER_IGNORE_LIST=["no-reply@accounts.google.com", "noreply@google.com", "mail-noreply@google.com", "verify@bolt.eu", "cyprus@delivery-marketing.bolt.eu"]

# true = разбирает, но не перекладывает файлы и ничего не удаляет
PARSER_DRY_RUN=false

# Компания по умолчанию для чеков без признаков (такси, авиабилеты, подписки).
# Пусто = такие документы идут в очередь на разбор человеку.
DEFAULT_COMPANY=orlanda_engineering

# Час отправки дайджеста фин директору, в TIMEZONE
DIGEST_HOUR=9

# С какого месяца реконсилер сверяет папки. Август не трогаем.
RECONCILE_FROM=2026-09

# ── Доска расходов в Monday ───────────────────────────────────────────────
# Токен общий с шестью другими приложениями стека, и отдельный получить
# негде: бюджет сложности Monday выделяется НА АККАУНТ (замер 28.09.2026:
# 20_000_000 со сбросом раз в 60с), а второй персональный токен Monday
# пользователю не выдаёт — перевыпуск заменит старый и уронит все шесть.
# Следствие: если синк вдруг встал с ошибкой авторизации, первым делом
# проверьте, не перевыпустили ли токен в другом проекте.
MONDAY_API_TOKEN=
# Пиновать обязательно: формат ошибки лимита уже менялся на версии 2025-07.
MONDAY_API_VERSION=2026-04
MONDAY_BOARD_ID=1550620081
MONDAY_TODO_BOARD_ID=1542673123
MONDAY_PROJECTS_BOARD_ID=1542627875
MONDAY_TASK_CODE_COLUMN=text9__1

# Наши поля -> id колонок доски. Все заведены и сверены 28.09.2026.
# Источник привязки к проекту отдельной колонкой на доску НЕ выносится:
# поле остаётся в базе, на доске фин директору нужен сам проект.
# Колонка категории на доске называется «OUT Category», адресуется по id.
# У дропдауна стоит limit_select=1 — ровно одна категория на строку.
MONDAY_COLUMNS={"amount_eur":"numeric__1","currency":"color_mm69asdm","doc_date":"date__1","payment_date":"date_mm69a728","doc_type":"color_mm69mgpx","internal_no":"text_mm69n4aj","project":"board_relation_mm6chnqv","tasks":"board_relation_mm6cqt3m","service":"board_relation_mm6c2gnx","source_file":"link_mm69vhd6","billing_month":"text_mm6cvz81","vendor":"text_mm7mk3e1","payer":"color_mm7mtp08","amount_original":"text_mm7ma2xp","category":"dropdown_mm7m3t5h","doc_id":"text_mm7mzfpn","source":"color_mm7mtddd"}

# Все расходы идут в одну группу Out, всегда. Групп по месяцам нет:
# месяц стоит в колонке Billing month у каждой строки, а доску по
# месяцам не режут.
MONDAY_GROUP_ID=group_mm5x742

# Выключено до ручной приёмки, ровно как PARSER_DRY_RUN в спеке №2.
MONDAY_SYNC_ENABLED=false
MONDAY_DRY_RUN=true
MONDAY_SYNC_INTERVAL_S=120
MONDAY_BATCH_SIZE=5

# ── Курсы валют ───────────────────────────────────────────────────────────
# ECB покрывает USD и ILS, но НЕ покрывает GEL и AZN — проверено.
# НБГ отсюда универсальный запасной источник: публикует курсы в лари
# примерно для сорока валют, пересчёт кросс-курсом через лари.
FX_ECB_URL=https://api.frankfurter.dev/v1
FX_NBG_URL=https://nbg.gov.ge/gw/api/ct/monetarypolicy/currencies/en/json/

# Порог нечёткого совпадения названия проекта: «Orhot Tota» против
# «Orhot Tora» даёт 0.9.
PROJECT_MATCH_MIN_RATIO=0.85
